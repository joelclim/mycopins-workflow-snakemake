# The main entry point of your workflow.
# After configuring, running snakemake -n in a clone of this repository should successfully execute a dry-run of the workflow.

from snakemake.utils import validate

configfile: "config/config.yaml"

# Fail fast on config typos / missing keys (batches, transects, ipt_gbif, ...).
validate(config, "schemas/config.schema.yaml")

LOCATION = config["location"]
BATCHES = list(config["batches"].keys())
TRANSECTS = list(config["transects"].keys())
import re

BATCH_PATTERN = "|".join(re.escape(batch) for batch in BATCHES)
TRANSECT_PATTERN = "|".join(re.escape(transect) for transect in TRANSECTS)

wildcard_constraints:
    batch=BATCH_PATTERN,
    transect=TRANSECT_PATTERN

def TRANSECT_BATCHES(wildcards):
    return config["transects"][wildcards.transect]

report: "report/workflow.rst"

# Allow users to fix the underlying OS via singularity.
singularity: "docker://continuumio/miniconda3"


rule all:
    input:
        # The first rule should define the default target files
        # Subsequent target rules can be specified below. They should start with all_*.
        expand("results/tables/{batch}_cleaned_counts.csv", batch=BATCHES),
        expand("results/tables/{batch}_cleaned_clusters.csv", batch=BATCHES),
        expand("results/tables/{batch}_complete_clusters.csv", batch=BATCHES),
        expand("results/tables/{batch}_organisms.csv", batch=BATCHES),
        expand("results/tables/{batch}_sample_clusters.csv", batch=BATCHES),
        expand("results/tables/mycopins_{transect}_environment.csv", transect=TRANSECTS),
        expand("results/tables/mycopins_{transect}_community.csv", transect=TRANSECTS),
        expand("results/tables/mycopins_{transect}_organisms.csv", transect=TRANSECTS),
        expand("results/tables/mycopins_{transect}_sample_clusters.csv", transect=TRANSECTS),
        "results/tables/oulanka_mycopins_environment.csv",
        "results/tables/oulanka_mycopins_community.csv",
        "results/tables/oulanka_mycopins_organisms.csv",
        "results/tables/oulanka_mycopins_sample_clusters.csv",
        "results/report/ipt_gbif/event.txt",
        "results/report/ipt_gbif/occurrence.txt",
        "results/report/ipt_gbif/dna-derived.txt",
        "results/report/ipt_gbif/occurrence-core.txt"

include: "rules/clean.smk"
include: "rules/identify.smk"
include: "rules/capture.smk"
include: "rules/reduce.smk"
include: "rules/gbif.smk"
