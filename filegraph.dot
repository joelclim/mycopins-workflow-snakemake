digraph snakemake_dag {
    graph[bgcolor="transparent", margin=0.25, pad=0.4, nodesep=0.9, ranksep=1.15, newrank=true, splines=polyline];
    node[shape=box, style=rounded, fontname=sans,                 fontsize=10, penwidth=2];
    edge[penwidth=2, color=grey];
	subgraph cluster_main {
		color="transparent";
		penwidth=0;
		margin=20;

