	subgraph cluster_legend {
		label="Legend";
		labelloc="t";
		fontsize=16;
		fontname=sans;
		color="#808080";
		style="rounded,filled";
		fillcolor="white";
		penwidth=1.5;
		margin=16;

		legend [ shape=plain, margin=0, label=<<table border="1" color="#808080" cellspacing="0" cellborder="1" cellpadding="7" bgcolor="white">
		<tr>
			<td bgcolor="white" align="center"><b><font point-size="15">{batch}</font></b></td>
			<td bgcolor="white" align="center"><b><font point-size="15">{transect}</font></b></td>
		</tr>
		<tr>
			<td align="left"><font face="monospace">fa23_transectC</font></td>
			<td align="left"><font face="monospace">transectA</font></td>
		</tr>
		<tr>
			<td align="left"><font face="monospace">sp24_transectC</font></td>
			<td align="left"><font face="monospace">transectB</font></td>
		</tr>
		<tr>
			<td align="left"><font face="monospace">sp24_transectA_1</font></td>
			<td align="left"><font face="monospace">transectC</font></td>
		</tr>
		<tr><td align="left"><font face="monospace">sp24_transectA_2</font></td><td border="0"></td></tr>
		<tr><td align="left"><font face="monospace">su24_transectA_1</font></td><td border="0"></td></tr>
		<tr><td align="left"><font face="monospace">su24_transectA_2</font></td><td border="0"></td></tr>
		<tr><td align="left"><font face="monospace">fa24_transectB_1</font></td><td border="0"></td></tr>
		<tr><td align="left"><font face="monospace">fa24_transectB_2</font></td><td border="0"></td></tr>
		<tr><td align="left"><font face="monospace">fa24_transectB_3</font></td><td border="0"></td></tr>
		<tr><td align="left"><font face="monospace">fa24_transectB_4</font></td><td border="0"></td></tr>
		</table>>]
	}
